      "critical_threshold_kwh": 5
    },
    {
      "key": "lighting",
      "name": "照明电表",
      "meter_id": "44588",
      "expected_address_contains": "[照明]",
      "warning_threshold_kwh": 30,
      "critical_threshold_kwh": 15
    }
  ]
}
